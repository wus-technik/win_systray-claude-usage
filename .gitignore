# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# Velopack packaging output
Releases/
publish/
*.nupkg

# User-specific / IDE
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/

# Rider / VS Code
*.DotSettings.user

# Logs & misc
*.log

# Local build output (publish dir, extracted release notes)
artifacts/

# The user-global ignore file carries a "build/**/*" rule, which silently hides new files in this
# repo's build/ directory — that is how changelog-section.ps1 first reached CI as a missing script.
# A repo .gitignore outranks the global one, so keep the build scripts explicitly tracked.
!build/
!build/*.ps1
